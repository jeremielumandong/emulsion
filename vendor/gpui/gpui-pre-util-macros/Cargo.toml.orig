[package]
name = "gpui-pre-util-macros"
version = "0.3.5"
edition = { workspace = true }
publish = true
license = "Apache-2.0"
description = "Utility macros for Zed (gpui-pre snapshot of zed@d89e9c2)"
repository = "https://github.com/zed-industries/zed"

[package.metadata.gpui-pre]
zed-crate = "util_macros"
zed-version = "0.1.0"
zed-rev = "d89e9c2124b2786a390c7a451c7488601b4da2e1"

[lib]
path = "src/util_macros.rs"
proc-macro = true
doctest = false
name = "util_macros"

[features]
perf-enabled = []

[dependencies]
quote = { workspace = true }
syn = { workspace = true }
perf = { workspace = true }

[lints]
workspace = true
