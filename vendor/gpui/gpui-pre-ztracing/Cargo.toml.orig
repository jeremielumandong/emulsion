[package]
name = "gpui-pre-ztracing"
version = "0.3.5"
edition = { workspace = true }
publish = true
license = "Apache-2.0"
description = "Zed's `ztracing` crate (gpui-pre snapshot of zed@d89e9c2)"
repository = "https://github.com/zed-industries/zed"

[package.metadata.gpui-pre]
zed-crate = "ztracing"
zed-version = "0.1.0"
zed-rev = "d89e9c2124b2786a390c7a451c7488601b4da2e1"

[lib]
name = "ztracing"

[features]
tracy = ["tracing-tracy", "tracy-client"]
web = ["dep:async-channel", "dep:js-sys", "dep:wasm-bindgen", "dep:web-sys"]

[dependencies]
zlog = { workspace = true }
tracing = { workspace = true }
tracing-subscriber = "0.3.22"
ztracing_macro = { workspace = true }

[target.'cfg(not(target_family = "wasm"))'.dependencies]
tracing-tracy = { version = "0.11.4", optional = true, features = ["enable", "ondemand"] }
tracy-client = { version = "0.18.2", optional = true, features = ["enable", "ondemand"] }

[target.'cfg(target_family = "wasm")'.dependencies]
async-channel = { workspace = true, optional = true }
js-sys = { workspace = true, optional = true }
wasm-bindgen = { workspace = true, optional = true }
web-sys = { version = "0.3", features = ["console", "Performance"], optional = true }

[lints]
workspace = true
