# Emulsion — Windows code signing (Azure Artifact Signing / Trusted Signing)
#
# Copy to `.env` (gitignored) and fill in your values. Read by
# scripts\build-windows.ps1 -Sign and the scripts it calls. Shell environment
# variables override this file; `.env.local` overrides `.env`.
# Only AZURE_* and EMULSION_SIGN* keys are read.

# Trusted Signing account -> Overview -> Account URI (region prefix matters).
AZURE_CODESIGNING_ENDPOINT=https://eus.codesigning.azure.net
AZURE_CODESIGNING_ACCOUNT=
AZURE_CODESIGNING_PROFILE=

# Certificate subject the verification step pins signatures to, copied verbatim
# from the certificate profile. Single quotes keep commas and spaces intact.
EMULSION_SIGN_EXPECTED_SUBJECT=

# Credentials: run `az login` for local builds. For unattended builds, use a
# service principal with the "Trusted Signing Certificate Profile Signer" role
# on the certificate profile.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Optional overrides.
# EMULSION_SIGN_DLIB=C:\path\to\Azure.CodeSigning.Dlib.dll
# EMULSION_SIGN_SIGNTOOL=C:\path\to\signtool.exe
# EMULSION_SIGN_AZURE_CLI_ONLY=1
